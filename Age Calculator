<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        .md{
            width: 250px;
            height: 180px;
            border: 20px outset navy;
            border-radius: 10px;
            padding: 25px;
            text-align: center;
        }
        .md h1{
            color: rgb(138, 14, 134);
            text-decoration: underline goldenrod;
        }
        .md input{
            height: 30px;
        }
    </style>
</head>
<body>
    <div class="md">
        <h1>Age Calculator</h1>
        <input type="date" name="dob" id="dob" style="width: 140px; background-color: aquamarine; border-radius:5px ; padding: 5px;">
        <input type="button" value="FindAge" id="FindAge" style="width: 90px; background-color: black; color: white; border-radius: 10px; height: 40px; font-weight:bold ;">
        <span id="yyy"></span>
        <span id="mmm"></span>
        <span id="ddd"></span>
    </div>

    <script>
var dp=document.getElementById('dob')
var btnage=document.getElementById('FindAge')
var yyy=document.getElementById('yyy')
var mmm=document.getElementById('mmm')
var ddd=document.getElementById('ddd')


btnage.addEventListener('click',()=>{
    var today=new Date()
    var y1=today.getFullYear()
    var m1=today.getMonth()
    var d1=today.getDate()
    var ds=dp.value
    var dob=new Date(ds)
    var y2=dob.getFullYear()
    var m2=dob.getMonth()
    var d2=dob.getDate()
    var yy=y1-y2
    var mm=""
    var dd=""
    if(m1<m2)
    {
        yy=yy-1
        mm=m1+12-m2

    }
    else{
        mm=m1-m2
    }
    if(d1<d2)
    {
        mm=mm-1
        dd=(d1+30)-d2
    }
    else{
        dd=d1-d2
    }
    yyy.innerHTML=yy + 'Years'
    mmm.innerHTML=mm + 'Months'
    ddd.innerHTML=dd + 'Days'

})
    </script>
    
</body>
</html>
